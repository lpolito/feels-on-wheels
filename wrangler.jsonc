{
  // Cloudflare serves the built app's files itself, and runs the Worker (`main`) only for paths with no file: real
  // routes get the shell with their own head tags, other forms of them a 301, and anything else a 404 (URL redesign
  // spec §5). Cloudflare's GitHub integration builds `main` with `npm run build` and deploys it with
  // `npx wrangler deploy`; other branches get preview links.
  "name": "feels-on-wheels",
  "main": "./src/worker/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/",
    // The Worker fetches the shell (`/`) through this binding.
    "binding": "ASSETS",
    // Cloudflare's default: /index.html redirects to /. The Worker redirects /about.html and trailing slashes.
    "html_handling": "auto-trailing-slash",
    // A path with no file goes to the Worker, which answers it; there's no file to fall back to.
    "not_found_handling": "none"
  },
  "workers_dev": true,
  "preview_urls": true,
  // Pull request previews: Workers Builds runs `npx wrangler preview` for other branches, which requires this block.
  // Empty: previews use the top-level settings (the Worker has no bindings beyond its assets).
  "previews": {}
}
